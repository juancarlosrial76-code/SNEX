# SNEX Environment Configuration

# Database
DATABASE_URL=postgresql://snex:snex@localhost:5432/snex
POSTGRES_PASSWORD=snex

# Redis
REDIS_URL=redis://localhost:6379

# Server
SNEX_SERVER__HOST=127.0.0.1
SNEX_SERVER__PORT=8080
SNEX_SERVER__WORKERS=4
SNEX_SERVER__REQUEST_TIMEOUT_SECONDS=30
SNEX_SERVER__MAX_REQUEST_SIZE=10485760

# Crypto
SNEX_CRYPTO__HSM_ENABLED=false
SNEX_CRYPTO__BACKUP_WRAPPING_KEY_ROTATION_DAYS=7
SNEX_CRYPTO__PQ_WRAPPER_ENABLED=true

# Issuer
SNEX_ISSUER__EPOCH_DURATION_DAYS=180
SNEX_ISSUER__CREDENTIAL_LIFETIME_EPOCHS=3
SNEX_ISSUER__ADVANCE_ISSUANCE_EPOCHS=1
SNEX_ISSUER__GRACE_PERIOD_DAYS=14
SNEX_ISSUER__GRACE_ANNUAL_CEILING_DAYS=30
SNEX_ISSUER__MINIMUM_COHORT_SIZE=30
SNEX_ISSUER__GOVERNANCE_KEY_ROTATION_EPOCHS=2
SNEX_ISSUER__INITIAL_QUORUM=2
SNEX_ISSUER__TOTAL_SHARES=3

# Verifier
SNEX_VERIFIER__MIN_BATCH_SIZE=8
SNEX_VERIFIER__MAX_BATCH_SIZE=50
SNEX_VERIFIER__BATCH_RELEASE_THRESHOLD_MIN=8
SNEX_VERIFIER__BATCH_RELEASE_THRESHOLD_MAX=12
SNEX_VERIFIER__MAX_ESTABLISHMENT_PERIOD_HOURS=72
SNEX_VERIFIER__MIN_ESTABLISHMENT_JITTER_HOURS=1
SNEX_VERIFIER__MAX_FAILED_ESTABLISHMENT_ATTEMPTS=2
SNEX_VERIFIER__PUBLICATION_COHORT_SIZE=5
SNEX_VERIFIER__RE_RELEASE_WAITING_PERIOD_DAYS=7
SNEX_VERIFIER__MINIMUM_ANONYMITY_SET=30
SNEX_VERIFIER__BAND_WIDTH=10
SNEX_VERIFIER__SET_DISPLAY_DELAY_HOURS=24

# Registry
SNEX_REGISTRY__NULLIFIER_RETENTION_DAYS=365
SNEX_REGISTRY__BLOCK_LIST_RETENTION_DAYS=365
SNEX_REGISTRY__TERMINATION_LIST_RETENTION_DAYS=3650
SNEX_REGISTRY__VOLUME_THRESHOLD_FOR_APPROVAL=1000

# Anchoring
SNEX_ANCHORING__ANCHOR_INTERVAL_SECONDS=3600
SNEX_ANCHORING__MAX_ANCHOR_GAP_SECONDS=259200
SNEX_ANCHORING__ANCHOR_SERVICES=["rfc3161"]
SNEX_ANCHORING__WITNESS_ENABLED=true
SNEX_ANCHORING__WITNESS_ENDPOINTS=[]

# Retention
SNEX_RETENTION__REGIME1_GENERATIONS=14
SNEX_RETENTION__REGIME1_GENERATION_INTERVAL_HOURS=24
SNEX_RETENTION__REGIME2_GENERATIONS=8
SNEX_RETENTION__REGIME2_GENERATION_INTERVAL_HOURS=168
SNEX_RETENTION__DATABASE_ROLLBACK_WINDOW_DAYS=7
SNEX_RETENTION__VOLUME_THRESHOLD=1000

# Level C
SNEX_LEVEL_C__MINORS_BLOCKED=true
SNEX_LEVEL_C__KEY_PACKAGE_RETENTION_DAYS=90
SNEX_LEVEL_C__MAX_FRESHNESS_LAG_SECONDS=3600
SNEX_LEVEL_C__ALLOWED_CIPHERSUITES=[1,2]
SNEX_LEVEL_C__REQUIRE_POST_QUANTUM=false

# Relay
SNEX_RELAY__ENDPOINTS=[]
SNEX_RELAY__LATENCY_BUDGET_MS=500
SNEX_RELAY__AVAILABILITY_THRESHOLD=0.99
SNEX_RELAY__POST_QUANTUM_HYBRID=true

# Logging
SNEX_LOGGING__LEVEL=info
SNEX_LOGGING__FORMAT=text
SNEX_LOGGING__JSON_OUTPUT=false
SNEX_LOGGING__LOG_SQL=false